# Gmail -- put credentials.json next to this file (download from Google Cloud Console,
# OAuth client of type "Desktop app"). token.json is written on first run.
# Every inbox message is screened; the label below is added after screening so the next pass skips it.
# Create this label in Gmail before running.
FINLEY_GMAIL_SCREENED_LABEL=finley-screened

# Optional: narrow which inbox messages get screened. Uses Gmail search syntax.
# Examples:
#   newer_than:1d subject:Draw             -- last 24h, subject contains 'Draw'
#   from:builder@example.com has:attachment  -- only from this sender, with attachments
#   (leave unset to screen every inbox message)
FINLEY_GMAIL_QUERY=

# Where messages land. Each message gets its own subdirectory.
FINLEY_LIBRARY=data/library

# Poll cadence.
FINLEY_POLL_SECONDS=30
